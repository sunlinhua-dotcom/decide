# decide server settings. Copy to .env and load it with `set -a; . ./.env; set +a`,
# or point systemd's EnvironmentFile= at it. Every value is optional.
# decide 服务端配置。复制成 .env 后 `set -a; . ./.env; set +a` 加载，或给 systemd 的 EnvironmentFile= 用。全部可选。

# Listen address and port. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 only on a trusted LAN.
# 监听地址与端口。前面有反代就保持 127.0.0.1；只在可信局域网里才用 0.0.0.0。
DECIDE_HOST=127.0.0.1
DECIDE_PORT=8796

# Where the SQLite database, key file and uploaded media live (default: ./data in this repo).
# 数据库、密钥文件、上传媒体放哪（默认本仓库 ./data）。
# DECIDE_HOME=/var/lib/decide
# DECIDE_MEDIA=/var/lib/decide/media

# The address people open in the browser; card links use it, and https:// turns on Secure cookies.
# 浏览器里打开的地址；卡片链接用它，https:// 开头时 cookie 自动加 Secure。
# DECIDE_PUBLIC=https://decide.example.com

# API key for the CLI and hooks. Leave unset to have one generated into $DECIDE_HOME/key on first start.
# 命令行和钩子用的密钥。不设就在第一次启动时生成到 $DECIDE_HOME/key。
# DECIDE_KEY=replace-with-at-least-24-random-characters

# Optional web password, so phones can log in without pasting the key.
# 可选的网页密码，手机上输密码就能登录，不用粘贴密钥。
# DECIDE_PASSWORD=replace-me

# 1 = trust CF-Connecting-IP / X-Forwarded-For from your reverse proxy (for login rate limiting).
# 1 = 信任反代给的 CF-Connecting-IP / X-Forwarded-For（登录限流按真实 IP 算）。
DECIDE_TRUST_PROXY=0

# 0 = let the reverse proxy serve web/ and media itself; by default this server does it.
# 0 = 网页和媒体交给反代出；默认由本服务自己出。
DECIDE_SERVE_STATIC=1
