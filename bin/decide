#!/usr/bin/env python3
"""decide：把要用户拍板的事推到 decide 决策板，等用户在网页上点完再拿回答案。

常用：
  decide ask  -p 项目 -t "N23 浴室远景" --before 旧.jpg --after 新.mp4 --products … --crash … --fix …
  decide pick -p 项目 -t "01 封面 · 挑底图" --choice "A::a.jpg::说明" --choice "B::b.jpg::说明"
  decide q "用哪个数据库" "SQLite::零运维、单机够用" "Postgres::要多机写入" --rec 1   # 纯文字选择题，网页画成大卡片
  decide wait <id> …        # 等答案，放后台跑；0=都定了 3=有被撤销的 124=超时
完整说明：decide help
"""
import argparse
import concurrent.futures as cf
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import webbrowser

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
CONF_PATH = os.path.expanduser(os.environ.get("DECIDE_CONFIG") or "~/.config/decide/config.json")
SESSION = os.environ.get("DECIDE_SESSION") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
LOCK_DIR = os.path.expanduser("~/.cache/decide")
SVG_EXT = {".svg"}
IMG_EXT = {".jpg", ".jpeg", ".png", ".webp", ".heic", ".tif", ".tiff", ".bmp", ".gif"}
VID_EXT = {".mp4", ".mov", ".m4v", ".webm"}
GOOD = {"通过", "可以", "对", "行", "ok", "OK", "保留", "用这个", "采用", "继续", "对，继续", "对，开始", "开始", "确认"}
BAD = {"返修", "打回", "不行", "重出", "重做", "不对", "否", "要改", "不对，要改", "改一下"}
WEB_EDGE, THUMB_EDGE = 1600, 480

# 有些代理 / 网络下域名的 IPv6 地址连不通，Python 会先试 IPv6 等满超时（每次可达 20 秒）。IPv4 排前面。
_getaddrinfo = socket.getaddrinfo


def _v4_first(*args, **kw):
    return sorted(_getaddrinfo(*args, **kw), key=lambda r: r[0] != socket.AF_INET)


socket.getaddrinfo = _v4_first

